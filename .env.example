# Database connection URL (required to run the pipeline).
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@127.0.0.1/database

# Contact-bearing User-Agent for SDE downloads, per FC API rules.
USER_AGENT=eve-killmap:process-sde/1.0.0 (your-contact@example.com)

# Where generated JSON files are written (defaults to ./data).
DATA_OUTPUT=data

# Log file path (defaults to ./process-sde.log).
LOG_FILE=process-sde.log

# Optional: overrides logging.level from config.yml.
# LOG_LEVEL=INFO
